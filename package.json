{
  "name": "github-control-center",
  "displayName": "%extension.name%",
  "description": "%extension.description%",
  "version": "1.11.2",
  "publisher": "mts88",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#24292f",
    "theme": "dark"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mts88/github-control-center.git"
  },
  "homepage": "https://github.com/mts88/github-control-center#readme",
  "bugs": {
    "url": "https://github.com/mts88/github-control-center/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "pull request",
    "code review",
    "notifications"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "githubControlCenter",
          "title": "%extension.name%",
          "icon": "images/icon-activity.svg"
        }
      ]
    },
    "views": {
      "githubControlCenter": [
        {
          "type": "webview",
          "id": "githubControlCenter.toReview",
          "name": "%views.toReview%",
          "icon": "$(git-pull-request)"
        },
        {
          "type": "webview",
          "id": "githubControlCenter.reviewed",
          "name": "%views.reviewed%",
          "icon": "$(git-pull-request)",
          "when": "!config.githubControlCenter.toReview.hideReviewed"
        },
        {
          "type": "webview",
          "id": "githubControlCenter.mine",
          "name": "%views.mine%",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "commands": [
      {
        "command": "githubControlCenter.refresh",
        "title": "%commands.refresh%",
        "category": "%extension.name%",
        "icon": "$(refresh)"
      },
      {
        "command": "githubControlCenter.signIn",
        "title": "%commands.signIn%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.openPr",
        "title": "%commands.openPr%",
        "category": "%extension.name%",
        "icon": "$(link-external)"
      },
      {
        "command": "githubControlCenter.openPrDetails",
        "title": "%commands.openPrDetails%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.openFileDiff",
        "title": "%commands.openFileDiff%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.openTextDiff",
        "title": "%commands.openTextDiff%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.viewFilesAsList",
        "title": "%commands.viewFilesAsList%",
        "category": "%extension.name%",
        "icon": "$(list-flat)"
      },
      {
        "command": "githubControlCenter.viewFilesAsTree",
        "title": "%commands.viewFilesAsTree%",
        "category": "%extension.name%",
        "icon": "$(list-tree)"
      },
      {
        "command": "githubControlCenter.review.addComment",
        "title": "%commands.review.addComment%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.review.addFileComment",
        "title": "%commands.review.addFileComment%",
        "category": "%extension.name%",
        "icon": "$(comment-add)"
      },
      {
        "command": "githubControlCenter.review.submit",
        "title": "%commands.review.submit%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.review.discard",
        "title": "%commands.review.discard%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.review.addSingleComment",
        "title": "%commands.review.addSingleComment%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.review.resolveThread",
        "title": "%commands.review.resolveThread%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.review.unresolveThread",
        "title": "%commands.review.unresolveThread%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.openSettings",
        "title": "%commands.openSettings%",
        "category": "%extension.name%",
        "icon": "$(gear)"
      },
      {
        "command": "githubControlCenter.copyPrUrl",
        "title": "%commands.copyPrUrl%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.copyBranchName",
        "title": "%commands.copyBranchName%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.muteRepo",
        "title": "%commands.muteRepo%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.checkoutPr",
        "title": "%commands.checkoutPr%",
        "category": "%extension.name%",
        "icon": "$(git-branch)"
      },
      {
        "command": "githubControlCenter.muteOrg",
        "title": "%commands.muteOrg%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.manageMutedRepos",
        "title": "%commands.manageMutedRepos%",
        "category": "%extension.name%"
      },
      {
        "command": "githubControlCenter.clearBriefCache",
        "title": "%commands.clearBriefCache%",
        "category": "%extension.name%"
      }
    ],
    "configuration": [
      {
        "title": "%settings.group.notifications%",
        "order": 1,
        "properties": {
          "githubControlCenter.badge.countToReview": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "%settings.badge.countToReview.description%"
          },
          "githubControlCenter.badge.countMine": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "%settings.badge.countMine.description%"
          },
          "githubControlCenter.badge.countReviewed": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "description": "%settings.badge.countReviewed.description%"
          },
          "githubControlCenter.notifications.enabled": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "description": "%settings.notifications.enabled.description%"
          }
        }
      },
      {
        "title": "%settings.group.filtering%",
        "order": 2,
        "properties": {
          "githubControlCenter.mutedRepos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 1,
            "markdownDescription": "%settings.mutedRepos.description%"
          },
          "githubControlCenter.toReview.hideDrafts": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "%settings.toReview.hideDrafts.description%"
          },
          "githubControlCenter.toReview.hideReviewed": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "description": "%settings.toReview.hideReviewed.description%"
          }
        }
      },
      {
        "title": "%settings.group.pullRequests%",
        "order": 3,
        "properties": {
          "githubControlCenter.updateBranch.defaultMethod": {
            "type": "string",
            "enum": [
              "REBASE",
              "MERGE"
            ],
            "enumDescriptions": [
              "%settings.updateBranch.defaultMethod.REBASE.description%",
              "%settings.updateBranch.defaultMethod.MERGE.description%"
            ],
            "default": "REBASE",
            "order": 1,
            "description": "%settings.updateBranch.defaultMethod.description%",
            "enumItemLabels": [
              "%settings.updateBranch.defaultMethod.REBASE.label%",
              "%settings.updateBranch.defaultMethod.MERGE.label%"
            ]
          },
          "githubControlCenter.files.layout": {
            "type": "string",
            "enum": [
              "tree",
              "flat"
            ],
            "enumDescriptions": [
              "%settings.files.layout.tree.description%",
              "%settings.files.layout.flat.description%"
            ],
            "default": "tree",
            "order": 2,
            "description": "%settings.files.layout.description%",
            "enumItemLabels": [
              "%settings.files.layout.tree.label%",
              "%settings.files.layout.flat.label%"
            ]
          }
        }
      },
      {
        "title": "%settings.group.ai%",
        "order": 4,
        "properties": {
          "githubControlCenter.ai.backend": {
            "type": "string",
            "enum": [
              "claude-code"
            ],
            "enumItemLabels": [
              "%settings.ai.backend.claude-code.label%"
            ],
            "enumDescriptions": [
              "%settings.ai.backend.claude-code.description%"
            ],
            "default": "claude-code",
            "scope": "machine",
            "order": 1,
            "description": "%settings.ai.backend.description%"
          },
          "githubControlCenter.ai.language": {
            "type": "string",
            "default": "English",
            "scope": "machine",
            "order": 2,
            "description": "%settings.ai.language.description%"
          },
          "githubControlCenter.ai.claude.command": {
            "type": "string",
            "default": "claude",
            "scope": "machine",
            "order": 3,
            "description": "%settings.ai.claude.command.description%"
          },
          "githubControlCenter.ai.claude.model": {
            "type": "string",
            "enum": [
              "sonnet",
              "haiku",
              "opus",
              ""
            ],
            "enumItemLabels": [
              "%settings.ai.claude.model.sonnet.label%",
              "%settings.ai.claude.model.haiku.label%",
              "%settings.ai.claude.model.opus.label%",
              "%settings.ai.claude.model.default.label%"
            ],
            "enumDescriptions": [
              "%settings.ai.claude.model.sonnet.description%",
              "%settings.ai.claude.model.haiku.description%",
              "%settings.ai.claude.model.opus.description%",
              "%settings.ai.claude.model.default.description%"
            ],
            "default": "sonnet",
            "scope": "machine",
            "order": 4,
            "description": "%settings.ai.claude.model.description%"
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "githubControlCenter.refresh",
          "when": "view == githubControlCenter.toReview || view == githubControlCenter.reviewed || view == githubControlCenter.mine",
          "group": "navigation@1"
        },
        {
          "command": "githubControlCenter.viewFilesAsTree",
          "when": "(view == githubControlCenter.toReview || view == githubControlCenter.reviewed || view == githubControlCenter.mine) && githubControlCenter.filesLayout == flat",
          "group": "1_manage@1"
        },
        {
          "command": "githubControlCenter.viewFilesAsList",
          "when": "(view == githubControlCenter.toReview || view == githubControlCenter.reviewed || view == githubControlCenter.mine) && githubControlCenter.filesLayout == tree",
          "group": "1_manage@1"
        },
        {
          "command": "githubControlCenter.openSettings",
          "when": "view == githubControlCenter.toReview || view == githubControlCenter.reviewed || view == githubControlCenter.mine",
          "group": "navigation@2"
        },
        {
          "command": "githubControlCenter.manageMutedRepos",
          "when": "view == githubControlCenter.toReview || view == githubControlCenter.reviewed || view == githubControlCenter.mine",
          "group": "1_manage"
        }
      ],
      "commandPalette": [
        {
          "command": "githubControlCenter.openPr",
          "when": "false"
        },
        {
          "command": "githubControlCenter.openPrDetails",
          "when": "false"
        },
        {
          "command": "githubControlCenter.openFileDiff",
          "when": "false"
        },
        {
          "command": "githubControlCenter.openTextDiff",
          "when": "false"
        },
        {
          "command": "githubControlCenter.review.addComment",
          "when": "false"
        },
        {
          "command": "githubControlCenter.review.addFileComment",
          "when": "resourceScheme == ghcc-pr"
        },
        {
          "command": "githubControlCenter.review.submit",
          "when": "githubControlCenter.hasPendingReview"
        },
        {
          "command": "githubControlCenter.review.discard",
          "when": "githubControlCenter.hasPendingReview"
        },
        {
          "command": "githubControlCenter.review.addSingleComment",
          "when": "false"
        },
        {
          "command": "githubControlCenter.review.resolveThread",
          "when": "false"
        },
        {
          "command": "githubControlCenter.review.unresolveThread",
          "when": "false"
        },
        {
          "command": "githubControlCenter.copyPrUrl",
          "when": "false"
        },
        {
          "command": "githubControlCenter.copyBranchName",
          "when": "false"
        },
        {
          "command": "githubControlCenter.muteRepo",
          "when": "false"
        },
        {
          "command": "githubControlCenter.checkoutPr",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "githubControlCenter.openTextDiff",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == prFile",
          "group": "1_open@1"
        },
        {
          "command": "githubControlCenter.checkoutPr",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "1_actions@1"
        },
        {
          "command": "githubControlCenter.openPr",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "1_actions@2"
        },
        {
          "command": "githubControlCenter.copyPrUrl",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "2_copy@1"
        },
        {
          "command": "githubControlCenter.copyBranchName",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "2_copy@2"
        },
        {
          "command": "githubControlCenter.muteRepo",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "3_manage@1"
        },
        {
          "command": "githubControlCenter.muteOrg",
          "when": "(webview == githubControlCenter.toReview || webview == githubControlCenter.reviewed || webview == githubControlCenter.mine) && webviewSection == pr",
          "group": "3_manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "githubControlCenter.review.addFileComment",
          "when": "resourceScheme == ghcc-pr",
          "group": "navigation@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "githubControlCenter.review.addComment",
          "when": "commentController == githubControlCenter",
          "group": "inline@1"
        },
        {
          "command": "githubControlCenter.review.addSingleComment",
          "when": "commentController == githubControlCenter && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "githubControlCenter.review.resolveThread",
          "when": "commentController == githubControlCenter && commentThread == canResolve",
          "group": "navigation@1"
        },
        {
          "command": "githubControlCenter.review.unresolveThread",
          "when": "commentController == githubControlCenter && commentThread == canUnresolve",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "vscode:prepublish": "node esbuild.js",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.12.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.5",
    "eslint": "^10.6.0",
    "mermaid": "^11.16.0",
    "ovsx": "^1.0.2",
    "semantic-release": "^25.0.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.0"
}
